# PostgreSQL Database（#71：dense 向量存储也迁至此，启用 pgvector 扩展）
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_USER=docqa
POSTGRES_PASSWORD=docqa
POSTGRES_DB=docqa

# Application
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# 封面图片存储（#47）
COVER_DIR=./uploads/covers
COVER_MAX_SIZE=5242880

# Document Processing
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Embedding：默认 local（进程内 sentence-transformers / bge-m3）；
# 推荐 http：由 docker-compose 的 Infinity 服务常驻提供（无冷启动）
EMBEDDING_PROVIDER=http
EMBEDDING_API_URL=http://localhost:7997
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
