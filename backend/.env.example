# PostgreSQL Database（#71：dense 向量存储也迁至此，启用 pgvector 扩展）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=docqa
POSTGRES_PASSWORD=docqa
POSTGRES_DB=docqa

# Application
APP_HOST=0.0.0.0
APP_PORT=8000
