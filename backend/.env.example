# Milvus Vector Database
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=doc_qa_documents

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=docqa
POSTGRES_PASSWORD=docqa
POSTGRES_DB=docqa

# Application
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Document Processing
CHUNK_SIZE=500
CHUNK_OVERLAP=50
