# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# 封面图片存储（#47）
COVER_DIR=./uploads/covers
COVER_MAX_SIZE=5242880

# Document Processing
CHUNK_SIZE=500
CHUNK_OVERLAP=50
